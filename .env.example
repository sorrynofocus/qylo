CHATBOT_MODEL_PROVIDER=azure

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-deployment-name>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Use these when CHATBOT_MODEL_PROVIDER=local.
# LOCAL_OPENAI_BASE_URL=http://localhost:8080/v1
# LOCAL_OPENAI_API_KEY=local-not-used
# LOCAL_MODEL_NAME=qwen3.5-9b

# Env-var equivalent of passing --exe on every run: CMD responses execute
# without the flag. UNSAFE responses are NOT covered - those still require
# --yolo on the command line, which has no .env equivalent /by design/.
# Any value other than true (case-insensitive) leaves execution off.
# CHATBOT_EXECUTE_COMMANDS=false

# Document chunking, in characters. Defaults are 1000 / 200 (settings.py).
# Overlap is how much text adjacent chunks share and must be smaller than
# the chunk size. Raise the size for docs with long, continuous prose;
# lower it for short reference/flag docs where tighter chunks retrieve better.
# CHATBOT_CHUNK_SIZE=1000
# CHATBOT_CHUNK_OVERLAP=200
